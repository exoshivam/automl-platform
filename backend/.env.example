# Copy to backend/.env. Defaults match docker-compose.dev.yml; only set what differs.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://automl:automl@127.0.0.1:5442/automl
REDIS_URL=redis://127.0.0.1:6381/0
S3_ENDPOINT_URL=http://127.0.0.1:9010
S3_ACCESS_KEY=automl
S3_SECRET_KEY=automl-dev-secret
S3_BUCKET=automl-data
JWT_SECRET=change-me-to-32+-random-chars-in-any-real-env
CORS_ORIGINS=["http://localhost:5180"]
PUBLIC_APP_URL=http://127.0.0.1:5180
# Optional
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# Google sign-in is off unless all three are set. The redirect URI must be on the APP origin (dev = Vite proxy),
# so the refresh cookie set by the callback is first-party; register exactly this URI in Google Cloud Console:
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_REDIRECT_URI=http://127.0.0.1:5180/api/v1/auth/google/callback
# prod: GOOGLE_REDIRECT_URI=https://<app host>/api/v1/auth/google/callback
# GOOGLE_SUCCESS_PATH=/projects   # SPA route after sign-in; the SPA then calls POST /auth/refresh
# LLM_PROVIDER=stub            # dev/test: stub; real: anthropic (+ ANTHROPIC_API_KEY)
# LLM_STUB_MODE=valid          # valid | invalid | down
# MLFLOW_TRACKING_URI=http://127.0.0.1:5005
