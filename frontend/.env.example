# Backend base URL. Default '/api/v1' goes through the Vite dev proxy to FastAPI on :8010 (same-origin, no CORS).
# VITE_API_URL=/api/v1
# MSW mocks (dev only). Default: only groups the backend hasn't built yet (data,training,evaluation);
# auth/orgs/projects use the real API. "all" = fully offline demo, "none" = real API everywhere.
# localStorage['automl.mocks'] overrides this per browser without a restart.
# VITE_MOCKS=data,training,evaluation
